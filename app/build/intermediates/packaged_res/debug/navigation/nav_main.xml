<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.studyhub.fragment.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />
        
    <fragment
        android:id="@+id/subjectFragment"
        android:name="com.studyhub.fragment.subject.SubjectListFragment"
        android:label="Subjects"
        tools:layout="@layout/fragment_subject_list">
        <action
            android:id="@+id/action_subjectFragment_to_addSubjectFragment"
            app:destination="@id/addSubjectFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />
    </fragment>

    <fragment
        android:id="@+id/addSubjectFragment"
        android:name="com.studyhub.fragment.subject.AddSubjectFragment"
        android:label="Add Subject"
        tools:layout="@layout/fragment_add_subject">
        <argument
            android:name="is_edit_mode"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="subject_id"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    
    <fragment
        android:id="@+id/scheduleFragment"
        android:name="com.studyhub.fragment.schedule.ScheduleListFragment"
        android:label="Schedule"
        tools:layout="@layout/fragment_schedule" />
    
    <fragment
        android:id="@+id/taskFragment"
        android:name="com.studyhub.fragment.TaskContainerFragment"
        android:label="Tasks"
        tools:layout="@layout/fragment_task_container" />
        
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.studyhub.fragment.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.studyhub.fragment.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/addTaskFragment"
        android:name="com.studyhub.fragment.AddTaskFragment"
        android:label="Add Task"
        tools:layout="@layout/fragment_add_task" />

    <fragment
        android:id="@+id/addDeadlineFragment"
        android:name="com.studyhub.fragment.deadline.AddDeadlineFragment"
        android:label="Add Deadline"
        tools:layout="@layout/fragment_add_deadline" />

    <fragment
        android:id="@+id/addNoteFragment"
        android:name="com.studyhub.fragment.note.AddNoteFragment"
        android:label="Add Note"
        tools:layout="@layout/fragment_add_note" />

    <fragment
        android:id="@+id/addScheduleFragment"
        android:name="com.studyhub.fragment.schedule.AddScheduleFragment"
        android:label="Add Schedule"
        tools:layout="@layout/fragment_add_schedule" />

</navigation>
