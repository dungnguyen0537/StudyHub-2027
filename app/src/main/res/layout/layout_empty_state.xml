<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- Using lottie would be ideal, but for now we use a cute vector or launcher icon -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@mipmap/owl_logo"
        android:alpha="0.6"
        android:contentDescription="Empty state icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Chưa có dữ liệu nào ở đây!"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Hãy bấm vào nút dấu + để thêm mới nhé."
        android:textSize="14sp"
        android:textColor="?attr/colorOutline"
        android:textAlignment="center" />
</LinearLayout>
