<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Lịch học hôm nay -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="6dp">

        <TextView
            android:id="@+id/tvWidgetScheduleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lịch học"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_widget_header_blue"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <ListView
            android:id="@+id/lvWidgetSchedules"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp" />

        <TextView
            android:id="@+id/tvWidgetScheduleEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Trống"
            android:gravity="center"
            android:visibility="gone"
            android:textSize="12sp"
            android:textColor="#888888" />

    </LinearLayout>

    <!-- Deadline sắp tới -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="6dp">

        <TextView
            android:id="@+id/tvWidgetDeadlineTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deadline"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:background="@drawable/bg_widget_header_red"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <ListView
            android:id="@+id/lvWidgetDeadlines"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="8dp" />

        <TextView
            android:id="@+id/tvWidgetDeadlineEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Trống"
            android:gravity="center"
            android:visibility="gone"
            android:textSize="12sp"
            android:textColor="#888888" />

    </LinearLayout>

</LinearLayout>
