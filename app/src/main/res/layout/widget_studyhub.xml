<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@drawable/widget_bg">

    <!-- Lịch học hôm nay -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvWidgetScheduleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lịch học"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="#3F51B5"
            android:gravity="center" />

        <ListView
            android:id="@+id/lvWidgetSchedules"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvWidgetScheduleEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Trống"
            android:gravity="center"
            android:visibility="gone"
            android:textSize="12sp"
            android:textColor="#888888" />

    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#DDDDDD"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Deadline sắp tới -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvWidgetDeadlineTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deadline"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="#F44336"
            android:gravity="center" />

        <ListView
            android:id="@+id/lvWidgetDeadlines"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvWidgetDeadlineEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Trống"
            android:gravity="center"
            android:visibility="gone"
            android:textSize="12sp"
            android:textColor="#888888" />

    </LinearLayout>

</LinearLayout>
