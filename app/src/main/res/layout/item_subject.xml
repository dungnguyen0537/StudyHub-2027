<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_md"
    android:layout_marginVertical="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Color Indicator -->
        <View
            android:id="@+id/vColorIndicator"
            android:layout_width="@dimen/color_indicator_width"
            android:layout_height="0dp"
            android:background="@color/subject_blue"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubjectName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginTop="@dimen/card_padding"
            android:layout_marginEnd="@dimen/spacing_md"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/btnFavorite"
            app:layout_constraintStart_toEndOf="@+id/vColorIndicator"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Lập trình di động" />

        <TextView
            android:id="@+id/tvSubjectCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body"
            app:layout_constraintEnd_toEndOf="@+id/tvSubjectName"
            app:layout_constraintStart_toStartOf="@+id/tvSubjectName"
            app:layout_constraintTop_toBottomOf="@+id/tvSubjectName"
            tools:text="IT101" />

        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_sm"
            android:src="@android:drawable/btn_star_big_off"
            app:layout_constraintBottom_toBottomOf="@+id/tvSubjectName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvSubjectName"
            android:contentDescription="@string/cd_favorite" />

        <LinearLayout
            android:id="@+id/llDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/card_padding"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/btnFavorite"
            app:layout_constraintStart_toStartOf="@+id/tvSubjectName"
            app:layout_constraintTop_toBottomOf="@+id/tvSubjectCode">

            <TextView
                android:id="@+id/tvCredits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/spacing_xs"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                app:drawableStartCompat="@android:drawable/ic_menu_sort_by_size"
                app:drawableTint="?attr/colorPrimary"
                tools:text="3 Tín chỉ" />

            <TextView
                android:id="@+id/tvTeacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_weight="1"
                android:drawablePadding="@dimen/spacing_xs"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_caption"
                app:drawableStartCompat="@android:drawable/ic_menu_myplaces"
                tools:text="Nguyễn Văn A" />
                
            <ImageView
                android:id="@+id/ivSyncStatus"
                android:layout_width="@dimen/icon_xs"
                android:layout_height="@dimen/icon_xs"
                android:layout_gravity="center_vertical"
                android:src="@android:drawable/stat_notify_sync"
                android:visibility="gone"
                app:tint="?attr/colorOutline" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
